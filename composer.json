{
	"name": "cedaro/satispress",
	"description": "Generate a Composer repository from installed WordPress plugins and themes.",
	"keywords": [
		"wordpress",
		"composer",
		"satis"
	],
	"type": "wordpress-plugin",
	"homepage": "https://github.com/cedaro/satispress",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Brady Vercher",
			"email": "brady@blazersix.com",
			"homepage": "https://www.cedaro.com/"
		},
		{
			"name": "Gary Jones",
			"homepage": "https://gamajo.com",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/cedaro/satispress/issues",
		"source": "https://github.com/cedaro/satispress"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true,
			"roots/wordpress-core-installer": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.1"
		},
		"preferred-install": "dist",
		"sort-packages": true
	},
	"prefer-stable": true,
	"repositories": {
		"wp-test-suite": {
			"type": "vcs",
			"url": "https://github.com/cedaro/wp-test-suite"
		}
	},
	"require": {
		"php": ">=8.1",
		"cedaro/wp-plugin": "^1.0",
		"composer/installers": "^2.0",
		"composer/semver": "^3.2",
		"pimple/pimple": "^3.5",
		"psr/container": "^2.0",
		"psr/log": "^3.0"
	},
	"require-dev": {
		"brain/monkey": "^2.2",
		"cedaro/wp-test-suite": "dev-develop",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.4",
		"phpcompatibility/phpcompatibility-wp": "^2",
		"phpunit/phpunit": "^10",
		"rector/rector": "^1.2",
		"roots/wordpress": "^7.0",
		"slevomat/coding-standard": "^8.22",
		"squizlabs/php_codesniffer": "^3.3",
		"wp-cli/i18n-command": "^2.4",
		"wp-coding-standards/wpcs": "^3"
	},
	"autoload": {
		"psr-4": {
			"SatisPress\\": "src/"
		},
		"files": [
			"src/functions.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"SatisPress\\Test\\": "tests/phpunit/"
		}
	},
	"scripts": {
		"install-codestandards": [
			"Dealerdirect\\Composer\\Plugin\\Installers\\PHPCodeSniffer\\Plugin::run"
		],
		"makepot": "./vendor/bin/wp i18n make-pot . languages/satispress.pot",
		"phpcs": "./vendor/bin/phpcs --standard=.phpcs.xml.dist",
		"phpcs:fix": "./vendor/bin/phpcbf --standard=.phpcs.xml.dist",
		"prepare-for-release": [
			"composer update --no-dev"
		],
		"rector:dry": "vendor/bin/rector process --dry-run",
		"rector": "vendor/bin/rector process",
		"test": "./vendor/bin/phpunit --testsuite=Unit --colors=always"
	}
}
